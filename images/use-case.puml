@startuml test
left to right direction
skinparam packageStyle rectangle

actor "Посетитель" as Visitor
actor "Пользователь" as User
actor "Админ" as Admin

usecase "Авторизоваться" as Auth
usecase "Зарегистрироваться" as Register
usecase "Просмотреть список событий" as EventList
usecase "Создать событие" as CreateEvent
usecase "Участвовать в событии" as JoinEvent
usecase "Редактировать событие" as EditEvent
usecase "Редактировать свое событие" as EditOwnEvent

Visitor --> Auth
Visitor --> Register
Visitor --> EventList

User --> EventList
User --> CreateEvent
User --> JoinEvent
User --> EditOwnEvent

Admin --> EventList
Admin --> CreateEvent
Admin --> JoinEvent
Admin --> EditEvent

EditOwnEvent ..> EditEvent : Use
Register ..> Auth: Use

@enduml