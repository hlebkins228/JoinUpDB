# Override the backend base URL when running `npm run dev`.
# In production the bundle is served from the same origin as the API
# so this can stay empty (relative `/api` calls are used by default).
VITE_API_BASE_URL=
VITE_API_PROXY=http://localhost:8080

# Yandex Maps JavaScript API key (https://developer.tech.yandex.ru/).
# Required for the address picker (event creation) and the map preview
# on the event detail screen.
VITE_YANDEX_MAPS_API_KEY=

# Separate Yandex "Geosuggest" API key. Without it the SuggestView widget
# (the dropdown with address suggestions) returns no results.
VITE_YANDEX_SUGGEST_API_KEY=
